# ChainBounty Contract Deployment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Network Configuration
NETWORK=testnet  # or mainnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployer Identity
DEPLOYER_IDENTITY=deployer  # soroban identity name
DEPLOYER_SECRET_KEY=  # optional: only if not using soroban identity

# Contract Initialization
ADMIN_ADDRESS=  # Address with dispute resolution privileges
PLATFORM_FEE_BPS=500  # 500 = 5%, max 1000 (10%)

# Testnet Funding
# Fund your deployer at: https://friendbot.stellar.org

# Mainnet (Requires Audit)
# NETWORK=mainnet
# SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org
# SOROBAN_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# ADMIN_ADDRESS=<MULTISIG_OR_GOVERNANCE_ADDRESS>
